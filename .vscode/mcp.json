{
    "servers": {
        "zurich-hackathon": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "compose",
                "--project-directory",
                "${workspaceFolder}",
                "run",
                "--rm",
                "--no-deps",
                "-T",
                "zurich-hackathon",
                "python",
                "main.py",
                "--transport",
                "stdio"
            ]
        },
        "basel-parking": {
