# Copy to .env and fill the three required secrets with distinct, random values.
# Keep .env private; never commit real credentials.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Separate application admin account, created in the swiss-discover realm.
# Demo default only; change before first startup outside a trusted demo.
SWISS_DISCOVER_ADMIN_PASSWORD=admin
MUSEUM_GUIDE_TOKEN=

# For a QR opened from another device, set this to the laptop's reachable LAN IP.
PUBLIC_HOST=localhost
FRONTEND_PORT=3000
BACKEND_PORT=8000
KEYCLOAK_PORT=8080
POSTGRES_HOST_PORT=5433

# Public AI (default): a missing key permits startup but chat reports not configured.
LLM_BASE_URL=https://api.publicai.co/v1
LLM_MODEL=swiss-ai/apertus-v1.5-70b-thinking
PUBLIC_AI_API_KEY=
LLM_API_KEY=
LLM_USER_AGENT=SwissDiscover/0.1 (hackathon demo)
LLM_IMAGE_INPUT=unknown

# Swisscom override: set LLM_BASE_URL and LLM_MODEL as documented in
# docs/INFRASTRUCTURE.md; SWISSCOM_API_KEY is forwarded as LLM_API_KEY.
SWISSCOM_API_KEY=

# Manage registry entries and public endpoints at /admin.
# Add trusted MCP hostnames here and recreate the backend before registering them.
MCP_ALLOWED_HOSTS=zurich-transit,museum-guide,localhost,127.0.0.1,10.10.52.203